{
  "version": 2,
  "builds": [
    { "src": "api/router.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/v1(?:/(.*))?", "dest": "/api/router.js?resource=$1" },
    { "src": "/api(?:/(.*))?", "dest": "/api/router.js?resource=$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "github": { "silent": true }
}
